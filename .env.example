FILE_ROOT=~/ToPublish
S3_ENDPOINT_KEYRING_SERVICE=mayfly-publish-endpoint
S3_REGION=us-east-1
S3_BUCKET_KEYRING_SERVICE=mayfly-publish-bucket
S3_ACCESS_KEY_ID_KEYRING_SERVICE=mayfly-publish-access-key
S3_SECRET_ACCESS_KEY_KEYRING_SERVICE=mayfly-publish-secret-key
# Store each keyring value under username mayfly-publish (see README).
S3_PREFIX=mayfly-staging/
S3_ADDRESSING_STYLE=path
SIGNED_URL_TTL_SECONDS=7200
MAX_FILE_BYTES=104857600
STAGED_OBJECT_MAX_AGE_HOURS=25
LOG_LEVEL=INFO

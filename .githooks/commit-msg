#!/bin/sh
set -eu
message=$(sed -n '1p' "$1")
case "$message" in
  Merge\ *|Revert\ *) exit 0 ;;
esac
if printf '%s\n' "$message" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-z0-9_-]+\))?(!)?: .{1,}$'; then
  exit 0
fi
printf '%s\n' 'Commit subject must use Conventional Commits, e.g. feat(storage): add S3 adapter' >&2
exit 1
